# ============================================
# .env.example — Variables de entorno
# Copia este archivo como .env y llena los valores
# NUNCA subas el .env real al repositorio
# ============================================

# Puerto en que corre la API (por defecto 3000)
PORT=3000

# Conexión a PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=tu_password_aqui
DB_NAME=policlinico_uleam

# Sincronización automática de la BD (solo en desarrollo)
# En producción debe ser false
DB_SYNC=true
